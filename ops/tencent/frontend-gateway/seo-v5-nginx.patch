--- a/cardnet-qzweb-www.conf
+++ b/cardnet-qzweb-www.conf
@@ -40,0 +41,28 @@
+    # SEO v5: review/merge these locations into the live server; do not replace it.
+    location = /storefront-assets.json {
+        add_header Cache-Control "no-cache";
+        add_header X-Content-Type-Options nosniff always;
+        try_files $uri =404;
+    }
+    # Only content-hashed raster names. Other catalog files remain revalidatable.
+    location ~ "^/catalog-products/(?:[A-Za-z0-9_-]+/)*(?:[0-9]+-)?[a-f0-9]{20,64}\\.(?:png|jpe?g|webp|avif)$" {
+        try_files $uri =404;
+        add_header X-Content-Type-Options nosniff always;
+        add_header Cache-Control "public, max-age=31536000, immutable";
+    }
+    # Existing immutable, dated exports: never overwrite these filenames.
+    location ^~ /catalog-products/glass-20261019/ {
+        try_files $uri =404;
+        add_header Cache-Control "public, max-age=31536000, immutable";
+        add_header X-Content-Type-Options nosniff always;
+    }
+    location ^~ /catalog-products/pro-usd-20261111/ {
+        try_files $uri =404;
+        add_header Cache-Control "public, max-age=31536000, immutable";
+        add_header X-Content-Type-Options nosniff always;
+    }
+    location ^~ /catalog-products/transparent-icons-20261020/ {
+        try_files $uri =404;
+        add_header Cache-Control "public, max-age=31536000, immutable";
+        add_header X-Content-Type-Options nosniff always;
+    }
