{
  "version": 1,
  "scope": "customer-support-local",
  "development_branch": "codex/customer-support-agent",
  "secrets": [
    {
      "id": "support_deepseek",
      "purpose": "小π客服 DeepSeek API，仅供后端调用",
      "github": {
        "repository": "cqz-cio/ai-topup-hub",
        "application": "actions",
        "name": "SUPPORT_DEEPSEEK_API_KEY",
        "settings_url": "https://github.com/cqz-cio/ai-topup-hub/settings/secrets/actions",
        "value_readable": false
      },
      "local_file": "work/codex-runtime/support-agent/private/config.json",
      "json_field": "api_key",
      "template": "docs/examples/support-agent.config.example.json",
      "import_environment_variable": "SUPPORT_DEEPSEEK_API_KEY",
      "committed_to_git": false,
      "required_for": "cmd/support-agent"
    }
  ]
}
