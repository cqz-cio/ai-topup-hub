[Unit]
Description=Zhixiang checkout queue (loopback only)
After=network.target

[Service]
Type=simple
User=zhixiang
Group=zhixiang
ExecStart=/usr/bin/redis-server /srv/zhixiang/shared/redis/redis.conf
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/zhixiang/shared/redis

[Install]
WantedBy=multi-user.target
