# User-selected domain. Install only after DNS and certificate verification.
# Only fixed route labels enter access logs: no args, cookies, bodies or referrers.
map $uri $paiplus_log_route {
    default "/other";
    / "/";
    /admin "/admin";
    /robots.txt "/robots.txt";
    ~^/api/(session|preview|preflight|redeem|result|results|result-by-code|lookup|lookup-batch|billing)$ $uri;
    ~^/api/admin/ "/api/admin/";
    ~^/api/management/ "/api/management/";
    /api/integration/deliver "/api/integration/deliver";
    ~^/assets/ "/assets/";
    ~^/icons/ "/icons/";
}
log_format paiplus_private '$remote_addr [$time_local] "$request_method $paiplus_log_route" $status $body_bytes_sent $request_time';
limit_req_zone $binary_remote_addr zone=paiplus_api:10m rate=12r/s;
server {
    listen 443 ssl;
    server_name cdk.qzweb.cloud;
    ssl_certificate /etc/letsencrypt/live/cdk.qzweb.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cdk.qzweb.cloud/privkey.pem;
    client_max_body_size 256k;
    client_body_buffer_size 256k;
    client_body_timeout 15s;
    client_header_timeout 15s;
    access_log /var/log/nginx/paiplus-access.log paiplus_private;
    # Session JSON must not be buffered to proxy/client temporary files.
    proxy_request_buffering off;
    proxy_max_temp_file_size 0;
    limit_req_status 429;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location ^~ /api/ {
        limit_req zone=paiplus_api burst=120 nodelay;
        proxy_pass http://127.0.0.1:8190;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
    }
    location / {
        proxy_pass http://127.0.0.1:8190;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
    }
}
server {
    listen 80;
    server_name cdk.qzweb.cloud;
    access_log /var/log/nginx/paiplus-access.log paiplus_private;
    location /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 301 https://cdk.qzweb.cloud$uri; }
}
